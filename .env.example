# ---------------------------------------------------------------------------
# Media API — environment template. Copy to .env (local) or enter these in
# your host's secret manager (Vercel → Project → Settings → Environment
# Variables). Placeholders only. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# development | production | test  (production disables the mock provider)
APP_ENV=development
LOG_LEVEL=INFO

# Public HTTPS base URL. Leave empty to auto-detect (on Vercel this uses the
# production domain). Set it when you attach a custom domain.
API_BASE_URL=

# Comma-separated browser origins allowed to call the API (bots don't need it).
CORS_ORIGINS=

# --- Database (REQUIRED in production) --------------------------------------
# Empty = local sqlite (./media_api.db; /tmp on Vercel = NOT persistent).
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
RUN_MIGRATIONS_ON_STARTUP=true

# Optional Redis for shared cache + rate limiting across instances.
# Example: redis://default:PASSWORD@HOST:6379/0
REDIS_URL=

# --- Owner dashboard --------------------------------------------------------
# First owner is created from these on startup if no owner exists yet.
# Password: 12+ characters. You can remove OWNER_PASSWORD after first boot.
OWNER_EMAIL=
OWNER_PASSWORD=
SESSION_TTL_HOURS=12
# Long random value used to sign expiring result links (e.g. `openssl rand -hex 32`).
SIGNING_SECRET=
# Optional server-to-server admin API secret (X-Admin-Key on /admin/*).
MASTER_API_SECRET=

# --- Providers ----------------------------------------------------------------
PROVIDER_ORDER=youtube,soundcloud,spotify,apple_music
PROVIDER_TIMEOUT_SECONDS=10
# Fake results for local development only (always off when APP_ENV=production).
MOCK_PROVIDER_ENABLED=false

# YouTube (primary). Data API key enables quota-backed search/metadata;
# without it search uses yt-dlp and metadata uses oEmbed.
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_BACKEND=auto
# Enables yt-dlp stream/download URL resolution and MP3/MP4 conversion jobs.
# Only enable for content you are authorized to retrieve.
MEDIA_EXTRACTION_ENABLED=false
# Optional: path to a cookies.txt and/or an outbound proxy for yt-dlp.
YTDLP_COOKIES_FILE=
YTDLP_PROXY=

# Spotify (catalog only) — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

# Apple Music (catalog only) — either a pre-generated developer token...
APPLE_MUSIC_DEVELOPER_TOKEN=
# ...or the MusicKit key details to sign one (private key may use \n escapes).
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us

# SoundCloud — https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# --- Abuse protection (no subscription quotas; tune freely) ------------------
RATE_LIMIT_PER_MINUTE=120
LOGIN_ATTEMPTS_PER_MINUTE=10
MAX_ACTIVE_JOBS_PER_KEY=5
CACHE_TTL_SEARCH_SECONDS=300
CACHE_TTL_INFO_SECONDS=600

# --- Media jobs ----------------------------------------------------------------
JOB_MAX_MEDIA_DURATION_SECONDS=1800
JOB_MAX_OUTPUT_MB=300
JOB_TIMEOUT_SECONDS=900
JOB_MAX_ATTEMPTS=2
JOB_LEASE_SECONDS=1200
MAX_VIDEO_HEIGHT=720
RESULT_RETENTION_HOURS=24
RESULT_LINK_TTL_SECONDS=3600
WORKER_POLL_SECONDS=2
# Run the worker inside the API process (single-host only; ignored on Vercel).
WORKER_EMBEDDED=false
# Optional explicit ffmpeg binary path (otherwise PATH / imageio-ffmpeg).
FFMPEG_PATH=

# --- Result storage --------------------------------------------------------------
# local: only when API and worker share a disk. s3: any S3-compatible bucket
# (AWS S3, Cloudflare R2, Backblaze B2, MinIO) — required for Vercel + remote worker.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/results
S3_BUCKET=
S3_REGION=auto
# e.g. https://<accountid>.r2.cloudflarestorage.com (empty for AWS S3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Server port for container hosts (Vercel ignores it).
PORT=8000
