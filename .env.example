# ---------------------------------------------------------------------------
# Media API — environment template. Copy to .env and fill in values.
# NEVER commit a real .env with secrets.
# ---------------------------------------------------------------------------

APP_ENV=development

# Public base URL of this deployment (no hard-coded domain in code).
API_BASE_URL=https://api.YOUR_DOMAIN.com

# Database. Leave empty for local sqlite (./media_api.db).
# Production example: postgresql+psycopg://user:password@host:5432/media_api
DATABASE_URL=

# Redis. Leave empty for in-memory fallback (dev/test).
# Production example: redis://localhost:6379/0
REDIS_URL=

# Admin secret for /admin/* endpoints (required for key management).
MASTER_API_SECRET=change-me-to-a-long-random-secret

# Comma-separated origins, e.g. https://app.example.com,https://admin.example.com
# Development may use * ; production should list explicit origins.
CORS_ORIGINS=

LOG_LEVEL=INFO

# Provider order / selection
PROVIDER_ORDER=provider_a,provider_b,provider_c
# Set to false in production if you do not want deterministic fake results.
MOCK_PROVIDER_ENABLED=true
PROVIDER_TIMEOUT_SECONDS=10.0

# Provider credentials (all optional during initial development).
PROVIDER_A_API_KEY=
PROVIDER_A_BASE_URL=
PROVIDER_B_API_KEY=
PROVIDER_B_BASE_URL=
PROVIDER_C_API_KEY=
PROVIDER_C_BASE_URL=

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Cache TTLs (seconds)
CACHE_TTL_SEARCH_SECONDS=300
CACHE_TTL_INFO_SECONDS=600

# Server
PORT=8000
